{
  "realm": "condohub",
  "displayName": "CondoHub",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Administrador del condominio" },
      { "name": "RESIDENTE", "description": "Propietario o residente de una unidad" },
      { "name": "GUARDIA", "description": "Guardia de portería" }
    ]
  },
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-desarrollo-fija",
        "providerId": "rsa",
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "privateKey": [""],
          "certificate": [""]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "condohub-spa",
      "name": "CondoHub · aplicaciones web (shell y micro frontends)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:5175/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174",
        "http://localhost:5175",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    },
    {
      "clientId": "condohub-movil",
      "name": "CondoHub · app móvil de portería (Flutter, rol GUARDIA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "com.condohub.movil:/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.condohub.movil:/callback"
      }
    },
    {
      "clientId": "condohub-servicios",
      "name": "CondoHub · llamadas entre servicios (n8n, agentes, reportes)",
      "enabled": true,
      "publicClient": false,
      "secret": "${CONDOHUB_SERVICIOS_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-condohub-servicios",
      "enabled": true,
      "serviceAccountClientId": "condohub-servicios",
      "realmRoles": ["ADMIN"]
    },
    {
      "id": "00000000-0000-0000-0000-00000000a001",
      "username": "admin@condohub.test",
      "email": "admin@condohub.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Administrador",
      "lastName": "CondoHub",
      "credentials": [{ "type": "password", "value": "${USUARIOS_PRUEBA_PASSWORD}", "temporary": false }],
      "realmRoles": ["ADMIN"]
    },
    {
      "id": "00000000-0000-0000-0000-00000000a002",
      "username": "residente@condohub.test",
      "email": "residente@condohub.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Residente",
      "lastName": "Demo",
      "credentials": [{ "type": "password", "value": "${USUARIOS_PRUEBA_PASSWORD}", "temporary": false }],
      "realmRoles": ["RESIDENTE"]
    },
    {
      "id": "00000000-0000-0000-0000-00000000a003",
      "username": "guardia@condohub.test",
      "email": "guardia@condohub.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Guardia",
      "lastName": "Portería",
      "credentials": [{ "type": "password", "value": "${USUARIOS_PRUEBA_PASSWORD}", "temporary": false }],
      "realmRoles": ["GUARDIA"]
    }
  ]
}
