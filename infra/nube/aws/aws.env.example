# Copia este archivo a infra/.env en la VM de AWS y completa los valores. No lo subas a git con valores reales.

# IP pública fija de ESTA VM con guiones, más .sslip.io. Ej.: 23.23.173.175 -> 23-23-173-175.sslip.io
DOMINIO=

# Dominio de la VM de Azure (Keycloak, gateway, Gestión): auth./api. salen de aquí.
AZURE_DOMINIO=

AWS_REGION=us-east-1
TABLA_ACCESO=condohub-acceso

# Solo para el perfil `saga` (acceso-saga): URL de RabbitMQ en Azure, con su usuario y contraseña. Déjalo vacío hasta abrir el 5672.
RABBITMQ_URL=
