# Copia este archivo a infra/.env en la VM de Azure y completa los valores. NUNCA lo subas a git con valores reales.
# Evita el carácter $ en las contraseñas (el script lee este archivo con el shell).

# IP pública fija de la VM con puntos cambiados por guiones, más .sslip.io. Ej.: la IP 20.1.2.3 -> 20-1-2-3.sslip.io
DOMINIO=

# Keycloak y usuarios de prueba (los de CLAUDE.md raíz). Cambia las contraseñas: esto estará en internet.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
USUARIOS_PRUEBA_PASSWORD=
CONDOHUB_SERVICIOS_SECRET=

# Postgres de esta VM (Gestión y Keycloak). No se publica a internet.
POSTGRES_PASSWORD=

# Perfil de Gestión: `dev` carga las 200 unidades de demostración; en la defensa conviene dejarlo así.
GESTION_PERFIL=dev

# URL públicas de los servicios que corren en otras nubes (las usa el gateway). Hasta que existan, deja el marcador:
# Acceso en AWS, Servicio IA en AWS, Reservas y Agentes en Google Cloud.
ACCESO_URL=https://acceso.pendiente.invalid
IA_URL=https://ia.pendiente.invalid
RESERVAS_URL=https://reservas.pendiente.invalid
AGENTES_URL=https://agentes.pendiente.invalid
