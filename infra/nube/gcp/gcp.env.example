# Copia este archivo a infra/.env en la VM de Google Cloud y completa los valores. No lo subas a git con valores reales.

# IP pública fija de ESTA VM con guiones, más .sslip.io. Ej.: 35.232.160.36 -> 35-232-160-36.sslip.io
DOMINIO=

# Dominio de la VM de Azure (Keycloak y gateway): auth./api. salen de aquí.
AZURE_DOMINIO=

# IP pública de la VM de Azure, donde corre RabbitMQ (su 5672 debe estar abierto a la IP de esta VM).
RABBITMQ_HOST=
RABBITMQ_USER=condohub
RABBITMQ_PASSWORD=condohub

# Secretos de esta VM (se generan con openssl al crear el .env; ver infra/CLAUDE.md).
POSTGRES_PASSWORD=
RESERVAS_APP_KEY=base64:
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mismo valor que CONDOHUB_SERVICIOS_SECRET del .env de la VM de Azure (el cliente condohub-servicios del realm): lo usa Agentes.
CONDOHUB_SERVICIOS_SECRET=

# Opcionales: informes por voz y agente con modelo de lenguaje; sin claves esas funciones responden "no disponible".
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVEEDOR=gemini

# Demo de I4 (alertas de visitante recurrente): vacío = una vez por noche, a las 02:00 de La Paz.
I4_CADA_SEGUNDOS=
