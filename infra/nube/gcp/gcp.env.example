# Copia este archivo a infra/.env en la VM de Google Cloud y completa los valores. No lo subas a git con valores reales.

# IP pública fija de ESTA VM con guiones, más .sslip.io. Ej.: 35.232.160.36 -> 35-232-160-36.sslip.io
DOMINIO=

# Dominio de la VM de Azure (Keycloak y gateway): auth./api. salen de aquí.
AZURE_DOMINIO=

# IP pública de la VM de Azure, donde corre RabbitMQ (su 5672 debe estar abierto a la IP de esta VM).
RABBITMQ_HOST=
RABBITMQ_USER=condohub
RABBITMQ_PASSWORD=condohub

# Secretos de esta VM (se generan con openssl al crear el .env; ver infra/CLAUDE.md).
POSTGRES_PASSWORD=
RESERVAS_APP_KEY=base64:
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Mismo valor que CONDOHUB_SERVICIOS_SECRET del .env de la VM de Azure (el cliente condohub-servicios del realm): lo usa Agentes.
CONDOHUB_SERVICIOS_SECRET=

# Opcionales: informes por voz y agente con modelo de lenguaje; sin claves esas funciones responden "no disponible".
GEMINI_API_KEY=
# Una clave o varias separadas por coma (sin espacios): si una agota su límite se usa la siguiente. El agente y los reportes por voz la comparten.
GROQ_API_KEY=
LLM_PROVEEDOR=gemini

# n8n (avisos por correo y push). El SMTP es obligatorio: no hay buzón de pruebas en la nube.
N8N_ENCRYPTION_KEY=          # openssl rand -hex 24 (cifra las credenciales guardadas; no lo cambies después de importar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=               # contraseña de aplicación de Gmail; escríbela solo en la VM
MAIL_REMITENTE=              # la misma cuenta del SMTP
ADMIN_EMAIL=
GUARDIA_EMAIL=
MONEDA=BOB

# Demo de I4 (alertas de visitante recurrente): vacío = una vez por noche, a las 02:00 de La Paz.
I4_CADA_SEGUNDOS=

# S3 REAL de AWS para los reportes y los modelos de IA (ADR 0003). Opcional: sin estas variables se usa el SeaweedFS de esta VM. Las claves son las
# de un usuario IAM propio de IA (nunca las del admin de AWS); se escriben solo aquí, en la VM.
# S3_AWS_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_AWS_REGION=us-east-1
# S3_AWS_ACCESS_KEY=
# S3_AWS_SECRET_KEY=
# S3_BUCKET_REPORTES=condohub-reportes-<sufijo>
# S3_BUCKET_MODELOS=condohub-modelos-<sufijo>
# S3_PREFIJO_REPORTES=reportes/   # carpeta del bucket para los reportes (los modelos ya van a placas/)
# Fotos de rostros: memoria = no se guarda ninguna foto (solo el embedding en MongoDB); s3 = bucket de rostros (por omisión, SeaweedFS).
# ALMACEN_FOTOS=memoria
