# Un nombre por servicio bajo el mismo dominio; Caddy pide y renueva el certificado solo.

reservas.{$DOMINIO} {
	reverse_proxy reservas:8082
}

ia.{$DOMINIO} {
	reverse_proxy ia:8083
}

agentes.{$DOMINIO} {
	reverse_proxy agentes:8084
}

# Descarga de reportes: el navegador abre la URL firmada (G4) contra este nombre. Solo se expone la carpeta de reportes;
# fotos y modelos quedan sin camino público. Caddy conserva el Host, que forma parte de la firma.
almacen.{$DOMINIO} {
	# handle es excluyente y respeta este orden; un `respond` suelto se evaluaría ANTES que el proxy.
	handle /reportes/* {
		reverse_proxy minio:9000
	}
	handle {
		respond "No encontrado" 404
	}
}
