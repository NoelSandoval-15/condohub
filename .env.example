# Solo desarrollo. Copiar a infra/.env (Docker Compose lee el .env de la carpeta del compose, no el de la raiz):
#   cp .env.example infra/.env          (PowerShell: Copy-Item .env.example infra\.env)
# Todo tiene valor por defecto: este archivo solo hace falta para cambiar algo o para poner claves.
POSTGRES_PASSWORD=condohub
MONGO_INITDB_ROOT_PASSWORD=condohub
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
USUARIOS_PRUEBA_PASSWORD=Condohub123!
MINIO_ROOT_USER=condohub
MINIO_ROOT_PASSWORD=condohub123
CONDOHUB_SERVICIOS_SECRET=condohub-servicios-dev
N8N_ENCRYPTION_KEY=condohub-n8n-dev-key

# Reportes por voz (G4): elegir proveedor y poner SOLO la clave del elegido. Pedirla al equipo por mensaje privado; nunca se sube.
LLM_PROVEEDOR=groq            # groq o gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# Si tienes puertos ocupados en tu maquina (descomentar):
# GATEWAY_PORT=8090      # 8080 ocupado
# POSTGRES_PORT=5433     # 5432 ocupado por un PostgreSQL local