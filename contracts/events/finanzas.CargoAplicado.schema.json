{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finanzas.CargoAplicado.schema.json",
  "title": "finanzas.CargoAplicado",
  "description": "Gestión confirma que aplicó los cargos de la reserva (respuesta del paso 2).",
  "allOf": [
    {
      "$ref": "_sobre.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "finanzas.CargoAplicado"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reservaId",
            "unidadId",
            "cargoIds"
          ],
          "properties": {
            "reservaId": {
              "type": "string",
              "format": "uuid"
            },
            "unidadId": {
              "type": "string",
              "format": "uuid"
            },
            "cargoIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  ]
}
