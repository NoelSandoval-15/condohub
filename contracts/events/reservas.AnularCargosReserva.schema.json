{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reservas.AnularCargosReserva.schema.json",
  "title": "reservas.AnularCargosReserva",
  "description": "Compensación del paso 2 y cancelaciones (R7). Gestión crea notas de crédito; nunca borra cargos (F6). Idempotente por reservaId.",
  "allOf": [
    {
      "$ref": "_sobre.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "reservas.AnularCargosReserva"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reservaId",
            "unidadId",
            "alcance"
          ],
          "properties": {
            "reservaId": {
              "type": "string",
              "format": "uuid"
            },
            "unidadId": {
              "type": "string",
              "format": "uuid"
            },
            "alcance": {
              "enum": [
                "TODOS",
                "SOLO_GARANTIA"
              ],
              "description": "TODOS: saga fallida o cancelación hasta 48 h antes. SOLO_GARANTIA: cancelación tardía, se mantiene el costo de uso (R7)"
            }
          }
        }
      }
    }
  ]
}
